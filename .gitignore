# Runtime state (machine-specific)
config.json
config.local.json
server/data/

# The dev bed's own config (dev.py): a library path from THIS machine, so it is
# the checkout's to hold, not the repo's. Missing it means local/dev/music.
dev.config.json

# The folder docker-compose.yml mounts as /music — app state, not source. The
# app writes .mlo/data (config.json with the RYM cookie, auth.db,
# playlists.db), downloads and trash under it, so running the compose template
# inside the checkout must never put that in a commit. Two empty files were
# committed once this way; nothing else was, and this is the line that keeps
# it that way.
music/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

