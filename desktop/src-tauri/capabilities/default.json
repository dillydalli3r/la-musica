{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop capability for the main window (tray, folder picker, notifications). The shell talks to a server the user runs; it starts none.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}
