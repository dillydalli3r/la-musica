{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "la musica",
  "version": "1.0.0",
  "identifier": "com.musiclibraryoptimizer.lamusica",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "title": "la musica",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "visible": true,
        "backgroundThrottling": "disabled",
        "decorations": false,
        "url": "splash.html",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dillydalli3r/la-musica/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MUMzOTM1MTRGQ0ZEN0IKUldSNy9md1VOVGtjNUtYNzl6dWlnc3JRUm5hb1RhdDd5bk0wblJoci9tbVl0V25xdWJ5bFY2RWoK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "iOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "1.0.0",
      "infoPlist": "Info.plist"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
