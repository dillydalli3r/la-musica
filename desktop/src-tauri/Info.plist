<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Transport Security exemption for the webview.

	  A self-hosted la musica server is plain http on an address only the user
	  knows: a LAN IP, a Tailscale/MagicDNS name, or 127.0.0.1:8000 for the
	  Docker container running on the same machine. TLS is not optional for the
	  project to run without it - the server ships without a certificate, so
	  every request the React UI makes (fetch, WebSocket) is http:// or ws://.
	  ATS blocks exactly those requests by default, which is what makes the app
	  unusable against a real install.

	  NSAllowsArbitraryLoadsInWebContent keeps the exemption inside the webview:
	  the shell's native URLSession calls (there are none today - lib.rs has no
	  HTTP client) stay under full ATS, and NSExceptionDomains cannot be used
	  here because the host is chosen by the user at runtime, not by us.

	  Tauri looks for this file beside tauri.conf.json and merges it into the
	  generated plist for the macOS .app bundle.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<!--
		  The blanket key: the coarse exemption for a system that reads no scoped
		  key at all (macOS 10.11, per Apple's own note). It is kept because a
		  reader who has only ever seen the blanket recipe must find it here -
		  but on every macOS this app can run on it is the scoped key above that
		  decides, and this one is inert.
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>